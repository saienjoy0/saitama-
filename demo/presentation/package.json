    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "typescript": "6.0.3",
    "vite": "8.2.1"
  }
}
