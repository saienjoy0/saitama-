{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ResearchRunState",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "task_id", "topic", "run_root", "status", "phase", "round", "max_rounds", "pass_threshold", "created_at", "updated_at", "work_items", "rounds", "best", "last_error"],
  "properties": {
    "version": { "type": "string", "const": "1.0" },
    "task_id": { "type": "string", "minLength": 1 },
    "topic": { "type": "string", "minLength": 5 },
    "run_root": { "type": "string", "minLength": 1 },
    "status": { "type": "string", "enum": ["running", "completed", "exhausted", "failed"] },
    "phase": { "type": "string", "enum": ["planning", "researching", "writing", "evaluating", "finalized"] },
    "round": { "type": "integer", "minimum": 0, "maximum": 5 },
    "max_rounds": { "type": "integer", "minimum": 1, "maximum": 5 },
    "pass_threshold": { "type": "number", "minimum": 1, "maximum": 5 },
    "created_at": { "type": "string", "format": "date-time" },
    "updated_at": { "type": "string", "format": "date-time" },
    "work_items": { "type": "array", "items": { "$ref": "#/$defs/workItem" } },
    "rounds": { "type": "array", "items": { "$ref": "#/$defs/round" } },
    "best": { "oneOf": [{ "type": "null" }, { "$ref": "#/$defs/best" }] },
    "last_error": { "type": ["string", "null"] }
  },
  "allOf": [
    {
      "if": { "properties": { "status": { "const": "completed" } }, "required": ["status"] },
      "then": {
        "properties": {
          "phase": { "const": "finalized" },
          "best": {
            "allOf": [
              { "$ref": "#/$defs/best" },
              { "type": "object", "properties": { "passed": { "const": true } } }
            ]
          }
        }
      }
    },
    {
      "if": { "properties": { "status": { "enum": ["completed", "exhausted", "failed"] } }, "required": ["status"] },
      "then": { "properties": { "phase": { "const": "finalized" } } }
    }
  ],
  "$defs": {
    "workItem": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "role", "dimension_id", "round", "status", "attempt", "output_paths", "last_error"],
      "properties": {
        "id": { "type": "string", "minLength": 3 },
        "role": { "type": "string", "enum": ["planner", "scout", "writer", "evaluator"] },
        "dimension_id": { "type": ["string", "null"], "pattern": "^dim_[0-9]{3}$" },
        "round": { "type": "integer", "minimum": 0, "maximum": 5 },
        "status": { "type": "string", "enum": ["pending", "running", "completed", "partial", "failed"] },
        "attempt": { "type": "integer", "minimum": 0, "maximum": 2 },
        "output_paths": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
        "last_error": { "type": ["string", "null"] }
      }
    },
    "round": {
      "type": "object",
      "additionalProperties": false,
      "required": ["number", "researched_dimensions", "draft_path", "eval_path", "feedback_path", "score", "verdict", "status"],
      "properties": {
        "number": { "type": "integer", "minimum": 1, "maximum": 5 },
        "researched_dimensions": { "type": "array", "uniqueItems": true, "items": { "type": "string", "pattern": "^dim_[0-9]{3}$" } },
        "draft_path": { "type": ["string", "null"] },
        "eval_path": { "type": ["string", "null"] },
        "feedback_path": { "type": ["string", "null"] },
        "score": { "type": ["number", "null"], "minimum": 1, "maximum": 5 },
        "verdict": { "type": "string", "enum": ["pending", "PASS", "REVISE", "REJECT"] },
        "status": { "type": "string", "enum": ["researching", "writing", "evaluating", "completed"] }
      }
    },
    "best": {
      "type": "object",
      "additionalProperties": false,
      "required": ["round", "draft_path", "eval_path", "score", "passed"],
      "properties": {
        "round": { "type": "integer", "minimum": 1, "maximum": 5 },
        "draft_path": { "type": "string", "minLength": 1 },
        "eval_path": { "type": "string", "minLength": 1 },
        "score": { "type": "number", "minimum": 1, "maximum": 5 },
        "passed": { "type": "boolean" }
      }
    }
  }
}
