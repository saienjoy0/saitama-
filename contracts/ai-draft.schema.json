{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Untrusted model draft v0.2",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "job_type",
    "items",
    "reason",
    "uncertainties"
  ],
  "properties": {
    "schema_version": {
      "const": "0.2"
    },
    "job_type": {
      "enum": [
        "quest_suggestion",
        "reflection_prompt",
        "newspaper_draft",
        "conversation_bridge"
      ]
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 6,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "kind",
          "text",
          "source_refs",
          "template_id"
        ],
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "headline",
              "caption",
              "question",
              "quest"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1,
            "maxLength": 160
          },
          "source_refs": {
            "type": "array",
            "minItems": 1,
            "maxItems": 6,
            "uniqueItems": true,
            "items": {
              "type": "string"
            }
          },
          "template_id": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "reason": {
      "type": "string",
      "maxLength": 160
    },
    "uncertainties": {
      "type": "array",
      "maxItems": 3,
      "items": {
        "type": "string",
        "maxLength": 120
      }
    }
  }
}
